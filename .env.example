# One of the two, for Google Photorealistic 3D Tiles:
GOOGLE_TILES_API_KEY=        # Google Cloud: enable "Map Tiles API" + billing
CESIUM_ION_TOKEN=            # or: free Cesium ion account, same Google tiles (asset 2275207)
# Optional, only for --backend gemini (best teacher for the first ~100 pairs):
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# Hugging Face token if the model download asks for one
HF_TOKEN=
